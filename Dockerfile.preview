# Preview image for pull requests (used by .github/workflows/preview.yml): builds the site from the branch's
# source instead of serving the frozen gh-pages build, so reviewers can click through the changed bundle.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json webpack.config.js ./
COPY src ./src
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31.7-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/
COPY --from=build /app/dist/bundle.js /usr/share/nginx/html/
